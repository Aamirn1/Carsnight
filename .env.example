# Cars Night environment variables
# Copy this file to `.env` and fill in your values.

# SQLite database URL (local file path)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth.js secret (generate one with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for canonical URLs, OG tags, sitemap)
NEXTAUTH_URL=http://localhost:3000

# Admin account email (a user with this email is auto-promoted to ADMIN on login)
ADMIN_EMAIL=amir03115794492@gmail.com
