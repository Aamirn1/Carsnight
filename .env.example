# Cars Night environment variables
# Copy this file to `.env` and fill in your values.

# Supabase PostgreSQL connection string (get from Supabase Dashboard > Settings > Database)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.romhqgmsoabzowwvuvvp:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# NextAuth.js secret (generate one with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for canonical URLs, OG tags, sitemap)
NEXTAUTH_URL=http://localhost:3000

# Admin account email (a user with this email is auto-promoted to ADMIN on login)
ADMIN_EMAIL=amir03115794492@gmail.com

# Supabase API credentials (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://romhqgmsoabzowwvuvvp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8zGylLGhKA-jWJ2KOpHS0g_VDeDDcaL

# Google Gemini API key for the AI Car Assistant (primary provider)
# Get your key from https://aistudio.google.com/apikey
# Model defaults to gemini-2.0-flash (configurable via GEMINI_MODEL).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API key for the AI Car Assistant (fallback when Gemini is not set)
# Get your key from https://openrouter.ai/keys
# Model defaults to z-ai/glm-5.2:free (configurable via OPENROUTER_MODEL).
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_MODEL=z-ai/glm-5.2:free
